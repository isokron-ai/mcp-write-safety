{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mws.invalid/schema/mws-results-1.schema.json",
  "title": "mcp-writecheck results (mws-results/1)",
  "description": "One record per requirement per write path per scenario. There is deliberately no aggregate field (no total, percentage, score or passed flag), and no additional top-level property is allowed, so a wrapper cannot add one and still validate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "scope",
    "suite",
    "spec",
    "run",
    "target",
    "manifest",
    "plan",
    "results",
    "not_built",
    "measurements",
    "leftovers",
    "cleanup",
    "observations",
    "evidence",
    "safety"
  ],
  "properties": {
    "format": {
      "const": "mws-results/1"
    },
    "scope": {
      "type": "string",
      "description": "The first line of every report: what was tested and what was not."
    },
    "suite": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "spec": {
      "type": "object",
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "type": "string"
        }
      }
    },
    "run": {
      "type": "object",
      "required": [
        "id",
        "prefix",
        "started",
        "ended",
        "status",
        "stopped_reason",
        "writes",
        "processes_started"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "prefix": {
          "type": "string"
        },
        "started": {
          "type": "string"
        },
        "ended": {
          "type": "string"
        },
        "status": {
          "enum": [
            "complete",
            "stopped"
          ]
        },
        "stopped_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "writes": {
          "type": "integer"
        },
        "processes_started": {
          "type": "integer"
        }
      }
    },
    "target": {
      "type": "object",
      "required": [
        "confirm",
        "environment",
        "server",
        "catalog_fingerprint",
        "guard"
      ],
      "properties": {
        "confirm": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        },
        "server": {
          "type": "string"
        },
        "catalog_fingerprint": {
          "type": "string"
        },
        "guard": {
          "type": [
            "object",
            "null"
          ]
        },
        "mcp": {
          "type": "object",
          "description": "Spec 5.3: the MCP protocol revision and the transport used, and the client capabilities and extensions the tester declared; with the requests for input the server made during calls and what the tester answered (7.3, rule 10), and the patterns that decided what a result says (7.3, rule 11).",
          "required": [
            "revision",
            "transport",
            "client_capabilities",
            "per_call_capabilities",
            "extensions",
            "input_requests",
            "patterns"
          ],
          "properties": {
            "revision": {
              "type": [
                "string",
                "null"
              ]
            },
            "transport": {
              "enum": [
                "stdio",
                "streamable HTTP"
              ]
            },
            "client_capabilities": {
              "type": "object"
            },
            "per_call_capabilities": {
              "type": "array"
            },
            "extensions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "input_requests": {
              "type": "array"
            },
            "patterns": {
              "type": "object"
            },
            "notes": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Facts about the connection that are not verdicts, such as a server that failed on server/discover and was then used with initialize only."
            },
            "result_shapes": {
              "type": "object",
              "description": "Spec 7.3, rule 11: the result shape the declaration adopts by name and version (shape: the top level; tools: per tool, null for none).",
              "properties": {
                "shape": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "tools": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "manifest": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      }
    },
    "plan": {
      "type": "object",
      "required": [
        "hash"
      ],
      "properties": {
        "hash": {
          "type": "string"
        }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirement",
          "level",
          "write_path",
          "scenario",
          "verdict",
          "reason",
          "numbers",
          "steps",
          "notes",
          "attribution"
        ],
        "properties": {
          "requirement": {
            "type": "string",
            "pattern": "^MWS-[A-Z]+-[0-9]+$"
          },
          "level": {
            "enum": [
              "MUST",
              "SHOULD"
            ]
          },
          "write_path": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "resource",
              "tool",
              "arm"
            ],
            "properties": {
              "resource": {
                "type": "string"
              },
              "tool": {
                "type": "string"
              },
              "arm": {
                "const": "mcp"
              }
            }
          },
          "scenario": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "version"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            }
          },
          "verdict": {
            "enum": [
              "violated",
              "platform",
              "held",
              "not observed",
              "not tested",
              "not applicable",
              "self-attested"
            ]
          },
          "reason": {
            "type": "string"
          },
          "numbers": {
            "type": "object"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "test_hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$",
            "description": "What defines this record's test (mws-test-hash/1, MANIFEST.md \"Run identity\"): the tester build, the spec version, the requirement and level, the procedure and its version, the write path, the narrowed input schemas of the tools its resource block names (the arguments the test uses, and the names of other required arguments), the part of the tool entry the requirement judges, that resource block, the rest of the declaration except server, target, resources and limits, target.guard, the limits other than write_budget (and writes_per_second except for MWS-CONC-*), and the tester's MWS-IN-5 reading where the build has one. Adding an optional argument the test does not use keeps the hash. Absent in files written before it."
          },
          "test_hash_core": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$",
            "description": "Only on a record whose requirement judges part of the tool entry (the input schema for MWS-IN-2/3/5/6/7, the annotations for MWS-ANN-*, the description for MWS-CONC-5, MWS-RETRY-2 and MWS-TGT-3): the test hash without that part, so compare can tell a changed subject from a changed test."
          },
          "attribution": {
            "enum": [
              "server",
              "platform",
              "unresolved",
              null
            ],
            "description": "Spec 8.2 rule 3: for a requirement that lists platform, every violated or platform record carries server, platform or unresolved; null otherwise. A violated record is never quoted without it."
          }
        }
      }
    },
    "not_built": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "requirement",
          "verdict",
          "reason"
        ],
        "properties": {
          "requirement": {
            "type": "string"
          },
          "verdict": {
            "enum": [
              "not tested",
              "not applicable"
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "measurements": {
      "type": [
        "object",
        "null"
      ],
      "description": "Annex A: measured, never judged."
    },
    "leftovers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "resource",
          "id",
          "name",
          "how",
          "reason"
        ]
      }
    },
    "cleanup": {
      "type": [
        "object",
        "null"
      ]
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "check",
          "version",
          "resource",
          "data"
        ]
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "capture",
        "checksums",
        "signature"
      ],
      "properties": {
        "capture": {
          "type": [
            "object",
            "null"
          ]
        },
        "checksums": {
          "const": "SHA256SUMS"
        },
        "signature": {
          "oneOf": [
            {
              "type": [
                "string",
                "null"
              ],
              "description": "null: results.json is not signed. A string: the file name of the ssh signature of SHA256SUMS (--sign)."
            },
            {
              "$ref": "#/$defs/results_signature"
            }
          ]
        }
      }
    },
    "safety": {
      "type": "object",
      "description": "What the seat belts saw: the untouched-state canaries before and after the run, fixtures put back to their original values, how backend traffic was routed (the gate), the protocol spoken, and the run this one repeats. None of these is a verdict.",
      "required": [
        "canaries",
        "fixtures_restored",
        "gate",
        "protocol",
        "rerun_of"
      ],
      "additionalProperties": false,
      "properties": {
        "canaries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "tool",
              "unchanged"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "tool": {
                "type": "string"
              },
              "unchanged": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "fixtures_restored": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "resource",
              "restored"
            ],
            "properties": {
              "resource": {
                "type": "string"
              },
              "restored": {
                "type": "boolean"
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "gate": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "route",
            "description"
          ],
          "properties": {
            "route": {
              "type": "string"
            },
            "description": {
              "type": "string"
            }
          }
        },
        "protocol": {
          "type": [
            "string",
            "null"
          ]
        },
        "rerun_of": {
          "type": [
            "string",
            "null"
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Warnings about the declaration that bear on what the run can see, such as an ignored field the tool under test can set."
        },
        "run_losses": {
          "type": "array",
          "description": "Bystander losses found outside any check's records (a failed set-up, or after the last check: resets, global checks, fixture restore, clean-up). Any entry makes the run stopped.",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "description": "The run's identity (MANIFEST.md, \"Run identity\"): which tester build, spec, manifest, plan, tools and server build the results come from. Every member is stated or null; gaps lists each one not stated or not pinned. Optional in mws-results/1 (absent in files written before it).",
      "required": [
        "format",
        "tester",
        "spec",
        "manifest_sha256",
        "plan_hash",
        "tools_fingerprint",
        "test_hash",
        "server",
        "backend",
        "runner",
        "started",
        "finished",
        "provenance",
        "gaps"
      ],
      "properties": {
        "format": {
          "const": "mws-identity/1"
        },
        "tester": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version",
            "commit",
            "dirty"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "commit": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$",
              "description": "The git commit the tester was built from (build stamp); null for an unstamped build."
            },
            "dirty": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "The tester's sources had uncommitted changes when it was built."
            },
            "stale": {
              "type": "boolean",
              "description": "The compiled code is newer than the build stamp."
            }
          }
        },
        "spec": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version"
          ],
          "properties": {
            "version": {
              "type": "string"
            }
          }
        },
        "manifest_sha256": {
          "type": "string"
        },
        "plan_hash": {
          "type": "string"
        },
        "tools_fingerprint": {
          "type": "string",
          "description": "sha256 over the canonical, name-sorted tools/list entries (tools only)."
        },
        "test_hash": {
          "const": "mws-test-hash/1",
          "description": "The algorithm of every record's test_hash."
        },
        "server": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repo",
            "commit",
            "tag",
            "image",
            "recipe",
            "launch",
            "transport"
          ],
          "properties": {
            "repo": {
              "type": [
                "string",
                "null"
              ]
            },
            "commit": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
            },
            "tag": {
              "type": [
                "string",
                "null"
              ]
            },
            "image": {
              "type": [
                "string",
                "null"
              ],
              "description": "OCI image reference; pinned only with @sha256:<digest>."
            },
            "recipe": {
              "type": [
                "string",
                "null"
              ]
            },
            "launch": {
              "type": "string",
              "description": "How the tester reached or started the server (redacted)."
            },
            "transport": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "backend": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "image",
              "version"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "image": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "version": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "runner": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "os",
            "arch",
            "node",
            "ci"
          ],
          "properties": {
            "os": {
              "type": "string"
            },
            "arch": {
              "type": "string"
            },
            "node": {
              "type": "string"
            },
            "ci": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "provider",
                    "run_id",
                    "run_attempt",
                    "url",
                    "workflow_ref"
                  ],
                  "properties": {
                    "provider": {
                      "const": "github-actions"
                    },
                    "run_id": {
                      "type": "string"
                    },
                    "run_attempt": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "url": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "workflow_ref": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              ]
            }
          }
        },
        "started": {
          "type": "string"
        },
        "finished": {
          "type": "string"
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sources",
            "overridden"
          ],
          "properties": {
            "sources": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "overridden": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Each identity member not stated or not pinned, with why."
        },
        "rechecked_by": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version",
            "commit",
            "at",
            "records_rehashed"
          ],
          "description": "Set by recheck on its copy.",
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "commit": {
              "type": [
                "string",
                "null"
              ]
            },
            "at": {
              "type": "string"
            },
            "records_rehashed": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  },
  "$defs": {
    "results_signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "alg",
        "key_id",
        "public_key_pem",
        "digest",
        "value",
        "sums"
      ],
      "description": "An Ed25519 signature of this document with evidence.signature replaced by { format, alg, key_id, sums }: value = base64(Ed25519(\"mcp-writecheck/results-signature/1\\n\" + RFC 8785 canonical JSON)). Trust it only against a key pinned out of band.",
      "properties": {
        "format": {
          "const": "mws-results-signature/1"
        },
        "alg": {
          "const": "ed25519"
        },
        "key_id": {
          "type": "string",
          "pattern": "^ed25519-[0-9a-f]{16}$",
          "description": "ed25519- and the first 16 hex characters of sha256 of the public key's SPKI DER (the kronicle-lite key id)."
        },
        "public_key_pem": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "value": {
          "type": "string"
        },
        "sums": {
          "type": [
            "string",
            "null"
          ],
          "description": "The ssh signature file of SHA256SUMS, where one was also made (--sign)."
        }
      }
    }
  }
}
