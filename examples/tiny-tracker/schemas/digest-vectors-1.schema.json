{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://writesafety.dev/schemas/tiny-tracker/digest-vectors-1.schema.json",
  "title": "Digest test vectors",
  "description": "Cross-language vectors for RFC 8785 canonical bytes and domain-tagged SHA-256 (vectors/digest-1.json). Version 1 allows additional top-level members: a later release may add one without a new version; a consumer ignores members it does not know.",
  "type": "object",
  "properties": {
    "vectors": {
      "const": "digest-vectors/1"
    },
    "rule": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "input_json": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "canonical": {
            "type": "string"
          },
          "digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "expect": {
            "const": "reject"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "input_json",
          "domain",
          "note"
        ],
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "canonical",
              "digest"
            ]
          },
          {
            "required": [
              "expect"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "vectors",
    "rule",
    "cases"
  ]
}
