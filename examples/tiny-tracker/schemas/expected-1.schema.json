{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://writesafety.dev/schemas/tiny-tracker/expected-1.schema.json",
  "title": "Known-answer file (draft for 0.2.0)",
  "description": "expected/<version>.json: what a harness should report against one tiny-tracker build, keyed by that build's build_hash. Generated by running, never written by hand. Answers are sets, so a step that can only be observed or not observed does not flake. Version 1 allows additional top-level members: a later release may add one without a new version; a consumer ignores members it does not know.",
  "type": "object",
  "properties": {
    "expected": {
      "const": "expected/1"
    },
    "package": {
      "type": "object",
      "properties": {
        "name": {
          "const": "@mcp-write-safety/tiny-tracker"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "builds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "build_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "label": {
            "type": "string"
          },
          "start": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The command line, without tokens."
          },
          "writecheck": {
            "type": "object",
            "properties": {
              "version": {
                "type": "string"
              },
              "answers": {
                "type": "object",
                "patternProperties": {
                  "^MWS-[A-Z]+-[0-9]+$": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1,
                    "uniqueItems": true,
                    "description": "The answers a correct harness may give, as a set: a forced-but-not-guaranteed step lists each one it can give."
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "version",
              "answers"
            ],
            "additionalProperties": false
          },
          "contract": {
            "type": "object",
            "properties": {
              "repo": {
                "type": "string"
              },
              "commit": {
                "type": "string"
              },
              "answers": {
                "type": "object",
                "patternProperties": {
                  "^LRT-A[1-5]$": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1,
                    "uniqueItems": true,
                    "description": "The contract driver's own verdict strings, as a set."
                  }
                },
                "additionalProperties": false
              },
              "self_attested": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^LRT-A[1-5]$"
                }
              }
            },
            "required": [
              "repo",
              "commit",
              "answers"
            ],
            "additionalProperties": false
          },
          "fixture": {
            "type": "object",
            "patternProperties": {
              "^FX-[A-Z]+-[0-9]+$": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "uniqueItems": true,
                "description": "The answers a correct harness may give, as a set: a forced-but-not-guaranteed step lists each one it can give."
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "build_hash",
          "label",
          "start"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "expected",
    "package",
    "builds"
  ]
}
