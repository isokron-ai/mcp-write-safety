{
  "name": "@mcp-write-safety/tiny-tracker",
  "version": "0.4.0",
  "description": "Teaching MCP server for the MCP Write-Safety Requirements: a correct build and a build with one named defect per requirement.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mws",
    "write-safety",
    "example",
    "test-server",
    "conformance"
  ],
  "homepage": "https://isokron.ai/mws?utm_source=tiny-tracker-npm&utm_medium=npm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isokron-ai/mcp-write-safety.git",
    "directory": "examples/tiny-tracker"
  },
  "bugs": {
    "url": "https://github.com/isokron-ai/mcp-write-safety/issues"
  },
  "author": "IsoKron (Stormhaven Enterprises LLC) (https://isokron.ai)",
  "contributors": [
    "Joshua Bryan"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "tiny-tracker": "dist/src/cli.js",
    "fx-check": "dist/src/fx-check.js"
  },
  "files": [
    "dist/src",
    "writecheck.yaml",
    "README.md",
    "FIXTURE.md",
    "CHANGELOG.md",
    "LICENSE",
    "schemas",
    "vectors",
    "verify/python/tt_digest.py",
    "verify/python/check_schemas.py",
    "docs/decisions",
    "verify/python/tt_recount.py",
    "harness/adapters/__init__.py",
    "harness/adapters/tiny_tracker.py",
    "harness/adapter_config.py",
    "harness/selfcheck.py",
    "harness/contract.json",
    "expected/builds-0.2.0.json",
    "expected/0.2.0.json",
    "expected/0.2.0.md",
    "expected/builds-0.3.0.json",
    "expected/0.3.0.json",
    "expected/0.3.0.md",
    "expected/builds-0.4.0.json",
    "expected/0.4.0.json",
    "expected/0.4.0.md",
    "verify/python/check_openapi.py",
    "openapi.yaml",
    "CONTRIBUTING.md",
    "docs/STABILITY.md",
    "docs/patterns.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/cli.js all",
    "test": "npm run build && node --test --test-concurrency=1 dist/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "prepack": "npm run clean && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
